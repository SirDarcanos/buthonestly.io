---
import Button from "./Button.astro";
import { DOWNLOADS_BASE } from "../lib/cdn.mjs";
import type { DownloadItem } from "../types";
interface Props {
  downloads?: DownloadItem[];
}
const { downloads } = Astro.props;
const ext = (file: string) => file.split(".").pop()?.toUpperCase() ?? "FILE";
---

{
  downloads && downloads.length > 0 && (
    <section class="my-12">
      <p class="meta font-bold">
        <span class="bg-accent mr-3 inline-block size-2" />
        Downloads
      </p>
      <ul class="mt-4 flex flex-col gap-3">
        {downloads.map((d) => (
          <li>
            <Button
              href={d.href ?? `${DOWNLOADS_BASE}/${d.file}`}
              download={!d.href}
              external={Boolean(d.href)}
              icon={d.href ? "external" : "download"}
              badges={d.file ? [ext(d.file)] : undefined}
              data-track={d.href ? undefined : `Download: ${d.file}`}
            >
              {d.label ?? d.file}
            </Button>
          </li>
        ))}
      </ul>
    </section>
  )
}
