---
import AudioPlayer from "../components/AudioPlayer.astro";
import Divider from "../components/Divider.astro";
import Downloads from "../components/Downloads.astro";
import Newsletter from "../components/Newsletter.astro";
import Picture from "../components/Picture.astro";
import ReadTime from "../components/ReadTime.astro";
import ShareLinks from "../components/ShareLinks.astro";
import TableOfContents from "../components/TableOfContents.astro";
import TaxLinks from "../components/TaxLinks.astro";
import SinglePost from "../layouts/SinglePost.astro";
import {
  getRelatedPosts,
  getRenderableEssays,
  toPost,
  type RenderableEssay,
} from "../lib/essays";
import { breadcrumbList } from "../lib/schema.ts";
import { taxUrl } from "../taxonomies.ts";

import { render } from "astro:content";
import { type Post } from "../types.ts";

export async function getStaticPaths() {
  const essays = await getRenderableEssays();
  return Promise.all(
    essays.map(async (essay) => ({
      params: { slug: essay.record.slug },
      props: {
        essay,
        related: await getRelatedPosts(toPost(essay), 6),
      },
    })),
  );
}

interface Props {
  essay: RenderableEssay;
  related: Post[];
}

const { essay, related } = Astro.props;
const { entry } = essay;
const post = toPost(essay);
const { Content, headings } = await render(entry);
const publishDate = new Date(post.date);
// `modified` falls back to `date`, so only a real revision earns a line.
const modifiedDate = new Date(post.modified);
const updatedDate = modifiedDate > publishDate ? modifiedDate : null;
const longDate = (d: Date) =>
  d.toLocaleString("default", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const primarySection = post.categories[0];
const jsonLd = [
  breadcrumbList([
    { name: "Sections", path: "/section/" },
    ...(primarySection
      ? [{ name: primarySection, path: taxUrl("section", primarySection) }]
      : []),
    { name: post.title },
  ]),
];
---

<SinglePost
  title={post.seo.title}
  description={post.seo.description}
  type="article"
  article={post}
  jsonLd={jsonLd}
>
  <article
    id={"post-" + post.id}
    class="post border-line mt-20 border-b pb-10"
    data-content-version={post.contentHash}
  >
    <header class="mb-10 space-y-6">
      <div class="flex items-center gap-3">
        <span class="label">
          <TaxLinks names={post.categories} base="section" />
        </span>
        <Divider width={20} />
        <span class="meta"
          ><ReadTime content={post.body} suffix="min read" /></span
        >
      </div>
      <h1>{post.title}</h1>
      <p class="lead">
        {post.excerpt}
      </p>
      <div
        class="border-line flex flex-wrap items-baseline gap-x-6 gap-y-1 border-y py-4"
      >
        <time
          datetime={publishDate.toISOString()}
          class="label tracking-widest"
        >
          {longDate(publishDate)}
        </time>
        <p class="meta flex-1 tracking-widest sm:text-right">
          In <TaxLinks names={post.tags} base="topic" />
        </p>
      </div>
    </header>

    {
      post.cover && (
        <div data-agent-cover>
          <Picture
            src={post.cover}
            alt={post.featuredImageAlt ?? ""}
            caption={post.featuredImageCaption ?? ""}
            widths={[580, 768, 960, 1160, 1376]}
            sizes="(max-width: 820px) 100vw, 580px"
            class="w-full"
            priority
          />
        </div>
      )
    }

    <TableOfContents headings={headings} />

    <div
      class="post-content mt-7"
      data-agent-document
      data-agent-metadata={JSON.stringify({
        title: post.title,
        description: post.excerpt,
        published: post.date.slice(0, 10),
        updated: updatedDate ? post.modified.slice(0, 10) : undefined,
        sections: post.categories,
        topics: post.tags,
        narration: post.narrationUrl,
      })}
    >
      {
        post.narrationUrl && (
          <audio
            class="audio-enhance"
            src={post.narrationUrl}
            data-audio-label="Listen instead of reading"
            data-agent-ignore
          />
        )
      }
      <Content />
    </div>

    <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
      <p class="meta font-bold">
        <span class="bg-accent mr-3 inline-block size-2"></span><a
          href="/about/"
          rel="author">— Nico</a
        >
      </p>
      {
        updatedDate && (
          <time
            datetime={updatedDate.toISOString()}
            class="meta flex-1 tracking-widest sm:text-right"
          >
            Last updated {longDate(updatedDate)}
          </time>
        )
      }
    </div>
  </article>

  <ShareLinks title={post.title} path={post.url} tags={post.tags} />

  <Downloads downloads={post.downloads} />

  {
    related.length > 0 && (
      <section class="my-16">
        <h2 class="meta mb-3">More similar essays</h2>
        <ul>
          {related.map((rel) => (
            <li class="border-line border-t py-4">
              {/* Stacked rows on narrow screens — side by side the read time
                  steals width and forces the title to wrap early. */}
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:gap-4">
                <h3 class="flex-1">
                  <a
                    href={rel.url}
                    class="text-ink hover:text-accent"
                    data-track="Related post click"
                  >
                    {rel.title}
                  </a>
                </h3>
                <p class="meta flex-none sm:mt-2 sm:text-right">
                  <ReadTime content={rel.body} />
                </p>
              </div>
              <p class="excerpt">{rel.excerpt}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Newsletter />

  <AudioPlayer />
</SinglePost>
