---
import "../styles/global.css";

import SEO from "../components/SEO.astro";

import { Font } from "astro:assets";
import { SITE_TITLE } from "../consts.ts";
import { type Feed, type Post } from "../types.ts";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article" | "profile";
  article?: Post;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  feed?: Feed;
}

const { title, description, type, article, noindex, jsonLd, feed } =
  Astro.props;

// Preview deploys are PROD builds too, so the branch — set by Cloudflare Pages
// CI, absent locally — is what separates production from previews.
const isProductionDeploy =
  (import.meta.env.CF_PAGES_BRANCH ?? "main") === "main";

// The page's own feed goes first: readers that offer a single subscribe action
// take the first alternate, and on an archive that should be the archive.
const feeds = [feed, { title: SITE_TITLE, href: "/feed.xml" }].filter(
  (f) => f !== undefined,
);
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  {
    feeds.map((f) => (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={f.title}
        href={f.href}
      />
    ))
  }
  <meta name="generator" content={Astro.generator} />

  <Font cssVariable="--font-newsreader" preload />
  <Font cssVariable="--font-archivo" preload />

  <SEO
    title={title}
    description={description}
    type={type}
    article={article}
    noindex={noindex}
    jsonLd={jsonLd}
  />

  {/* Fathom analytics — production only. */}
  {
    import.meta.env.PROD &&
      import.meta.env.FATHOM_SITE_ID &&
      isProductionDeploy && (
        <script
          src="https://cdn.usefathom.com/script.js"
          data-site={import.meta.env.FATHOM_SITE_ID}
          defer
          is:inline
        />
      )
  }

  {/* Fire a Fathom event for any clicked element carrying data-track. */}
  <script>
    import { track } from "../lib/track";
    const trackClick = (e: MouseEvent) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-track]");
      const name = el?.dataset.track;
      if (name) track(name);
    };
    document.addEventListener("click", trackClick);
    // Middle-click opens a new tab without a click event — only auxclick.
    document.addEventListener("auxclick", (e) => {
      if (e.button === 1) trackClick(e);
    });
  </script>
</head>
