---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Label from "../../components/Label.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";
import { AUTHOR_ID, SITE_URL } from "../../consts.ts";
import { STATIC_BASE } from "../../lib/cdn.mjs";
import { breadcrumbList } from "../../lib/schema.ts";

import {
  VOICE_GROUPS,
  PHONON_VOICE_GROUPS,
  previewPath,
} from "../../lib/voice-catalogue.mjs";
const voiceGroups = PHONON_VOICE_GROUPS;

const sampleSentence =
  "Some mornings, the coffee tastes better than usual — and I never quite know why.";
const description =
  "Free AI voice generator with Phonon and Kokoro English voices. Generate complete MP3 or WAV speech on your device, with no signup required.";
const ogImage = `${SITE_URL}/og/free-ai-voice-generator.png`;
const ogImageAlt =
  "Free AI Voice Generator social preview showing text becoming an audio waveform.";
const applicationUrl = `${SITE_URL}/resources/free-ai-voice-generator/`;
const jsonLd = [
  breadcrumbList([
    { name: "Resources", path: "/resources/" },
    { name: "Free AI Voice Generator" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${applicationUrl}#application`,
    name: "Free AI Voice Generator",
    description,
    url: applicationUrl,
    applicationCategory: "MultimediaApplication",
    applicationSubCategory: "Text-to-Speech",
    operatingSystem: "Any",
    browserRequirements:
      "Phonon requires WebAssembly SIMD and module workers; optional WebGPU, with CPU fallback.",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: 0 },
    inLanguage: "en",
    featureList: [
      "Local text-to-speech generation",
      "37 Phonon English voices and 28 Kokoro English voices",
      "On-device synthesis",
      "Timed pauses",
      "MP3 and WAV downloads",
    ],
    creator: { "@id": AUTHOR_ID },
  },
];
---

<Layout
  title="Free AI Voice Generator"
  description={description}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  markdown
>
  <Container section id="voice-generator" className="md:max-w-2xl">
    <Label><a href="/resources/">Resources</a></Label>
    <h1 class="mt-6">Free AI Voice Generator</h1>

    <div class="post-content mt-7">
      <p>
        I built this free AI voice generator to turn text into speech without an
        account. Paste your text, choose a model and an English voice, and the
        complete audio is generated on your device.
      </p>
      <p>
        You can choose between <a
          href="https://huggingface.co/gradium/phonon-31m-en">Phonon</a
        >, with 25 English and 12 character voices, or <a
          href="https://huggingface.co/hexgrad/Kokoro-82M"
          target="_blank"
          rel="noopener">Kokoro</a
        >, with 28 American and British English voices. Both run in your
        browser, trying available WebGPU acceleration with a CPU fallback.
        Generation time depends on your device.
      </p>
    </div>

    <div
      class="bh-kokoro-tts-app border-line bg-surface mt-8 flex flex-col gap-6 border p-6"
      data-bhktw-instance="main"
      data-agent-ignore
    >
      <div class="flex flex-col gap-1.5">
        <label
          for="bhktw-text"
          class="text-muted font-sans text-[0.7rem] font-semibold tracking-[0.12em] uppercase"
          >Text to read aloud</label
        >
        <textarea
          id="bhktw-text"
          data-bhktw="text"
          rows="6"
          class="border-line bg-background text-ink min-h-32 w-full resize-y border px-3 py-2.5 font-sans text-base leading-normal disabled:opacity-50"
          placeholder="Paste an essay, paragraph, or other text you'd like to hear read aloud..."
        ></textarea>
      </div>

      <div class="flex flex-col gap-1.5">
        <label
          for="bhktw-model"
          class="text-muted font-sans text-[0.7rem] font-semibold tracking-[0.12em] uppercase"
          >Model</label
        >
        <select
          id="bhktw-model"
          data-bhktw="model"
          class="border-line bg-background text-ink w-full border px-3 py-2.5 font-sans text-base"
        >
          <option value="phonon">Phonon</option>
          <option value="kokoro">Kokoro</option>
        </select>
      </div>
      <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-2 sm:gap-6">
        <div class="flex min-w-0 flex-col gap-1.5">
          <label
            for="bhktw-voice"
            class="text-muted font-sans text-[0.7rem] font-semibold tracking-[0.12em] uppercase"
            >Voice</label
          >
          <select
            id="bhktw-voice"
            data-bhktw="voice"
            class="border-line bg-background text-ink w-full border px-3 py-2.5 font-sans text-base disabled:opacity-50"
          >
            {
              voiceGroups.map((group) => (
                <optgroup label={group.label}>
                  {group.voices.map(([value, name]) => (
                    <option value={value}>{name}</option>
                  ))}
                </optgroup>
              ))
            }
          </select>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5">
          <div class="flex items-center justify-between gap-4">
            <label
              for="bhktw-speed"
              data-bhktw="speed-label"
              class="text-muted font-sans text-[0.7rem] font-semibold tracking-[0.12em] uppercase"
              >Speed</label
            >
            <output
              for="bhktw-speed"
              data-bhktw="speed-value"
              class="text-ink font-mono text-sm tabular-nums">1×</output
            >
          </div>
          <input
            type="range"
            id="bhktw-speed"
            data-bhktw="speed"
            min="0.5"
            max="1.5"
            step="0.05"
            value="1"
            class="accent-accent h-10 w-full cursor-pointer disabled:cursor-default disabled:opacity-50"
          />
        </div>
      </div>
      <div
        class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center"
      >
        <button
          data-bhktw="generate"
          type="button"
          class="bg-accent text-background w-full shrink-0 cursor-pointer border-0 px-6 py-3 font-sans text-[0.9rem] font-semibold tracking-[0.02em] transition-opacity hover:opacity-90 disabled:cursor-default disabled:opacity-50 sm:w-auto"
        >
          Generate
        </button>
        <div class="flex min-w-0 flex-col gap-2 sm:flex-1">
          <div
            role="status"
            aria-live="polite"
            class="text-muted flex items-center gap-2.5 font-mono text-[0.8rem]"
          >
            <span
              data-bhktw="dot"
              class="bg-muted size-2 flex-none rounded-full"></span>
            <span data-bhktw="status-msg" class="min-w-0 break-words"
              >Click Generate to load the selected model. Cached files are
              reused.</span
            >
          </div>
          <div
            data-bhktw="progress"
            class="bg-faint hidden h-0.75 overflow-hidden"
          >
            <div class="bg-accent h-full w-0 transition-[width] duration-200">
            </div>
          </div>
        </div>
      </div>
      <div
        data-bhktw="err"
        role="alert"
        class="border-accent text-accent hidden border px-4 py-3 font-sans text-[0.9rem]"
      >
      </div>

      <div
        data-bhktw="output"
        class="border-line flex hidden flex-col gap-3 border-t pt-6"
      >
        <h2 class="text-lg tracking-tight">Generated audio</h2>
        <audio
          data-bhktw="audio"
          class="audio-enhance w-full"
          data-audio-label=""
          controls></audio>
        <div class="flex flex-wrap gap-3">
          <button
            type="button"
            data-bhktw="download-mp3"
            data-track="Voice download: mp3"
            class="border-line bg-background text-ink hover:border-accent hover:text-accent flex flex-none items-center gap-3 border px-4 py-3 font-sans text-base transition-colors disabled:cursor-default disabled:opacity-50"
            disabled
          >
            Download MP3
          </button>
          <button
            type="button"
            data-bhktw="download-wav"
            data-track="Voice download: wav"
            class="border-line bg-background text-ink hover:border-accent hover:text-accent flex flex-none items-center gap-3 border px-4 py-3 font-sans text-base transition-colors disabled:cursor-default disabled:opacity-50"
            disabled
          >
            Download WAV
          </button>
        </div>
      </div>
    </div>

    <section class="mt-14">
      <h2>How to use it</h2>
      <div class="post-content mt-4">
        <ul>
          <li>
            Paste your text, then choose Phonon or Kokoro and one of its voices.
          </li>
          <li>
            Add a pause by writing <code>[0.5s]</code> in the text for half a second
            of silence, or <code>[1s]</code> for a full second.
          </li>
          <li>
            Click <strong>Generate</strong>. When it finishes, play the audio or
            download it as an MP3 or WAV file.
          </li>
        </ul>
      </div>
    </section>

    <section class="mt-14">
      <details class="disclosure border-line border p-5">
        <summary class="callout-title">Voice samples</summary>
        <p class="text-muted text-base">
          Every clip reads the same line: <em>“{sampleSentence}”</em>
        </p>

        {
          Object.entries(VOICE_GROUPS).map(([model, groups]) => (
            <div
              data-voice-samples={model}
              class:list={[model !== "phonon" && "hidden"]}
            >
              {groups.map((group) => (
                <>
                  <h3 class="mt-6">{group.label}</h3>
                  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                    {group.voices.map(([id, name]) => (
                      <audio
                        class="audio-enhance w-full"
                        preload="none"
                        data-audio-label={name}
                        src={`${STATIC_BASE}/${previewPath(model, id)}`}
                        controls
                      />
                    ))}
                  </div>
                </>
              ))}
            </div>
          ))
        }
      </details>
    </section>

    <section class="mt-14">
      <h2>Limitations</h2>
      <div class="post-content mt-4">
        <p>
          Voice quality varies by model and voice. I update the generator as
          their developers release new versions.
        </p>
        <p>
          Both models produce 24&nbsp;kHz speech. WAV is uncompressed 16-bit
          mono (about 2.9&nbsp;MB per minute). MP3 uses 128&nbsp;kbps CBR, about
          960&nbsp;KB per minute.
        </p>
      </div>
    </section>

    <section class="mt-14">
      <h2>Frequently Asked Questions</h2>
      <div class="mt-4 flex flex-col gap-3">
        <details class="disclosure border-line border p-5">
          <summary class="callout-title">Can I generate long text?</summary>
          <div class="post-content mt-3">
            <p>
              Yes, but smaller sections are more practical. The 50,000-character
              limit prevents unusually large jobs; it does not guarantee that a
              single job of that size will finish on every device.
            </p>
          </div>
        </details>
        <details class="disclosure border-line border p-5">
          <summary class="callout-title"
            >Which languages and voices are supported?</summary
          >
          <div class="post-content mt-3">
            <p>
              Phonon offers 25 regular English voices and 12 English character
              voices. Kokoro offers 20 American English and 8 British English
              voices. Other languages and voice cloning are not included.
            </p>
          </div>
        </details>
        <details class="disclosure border-line border p-5">
          <summary class="callout-title">Which browsers work?</summary>
          <div class="post-content mt-3">
            <p>
              Phonon requires WebAssembly SIMD and module workers. WebGPU is
              optional: if it cannot start, the same model runs on the CPU. This
              page uses one CPU thread and does not require cross-origin
              isolation. Kokoro also supports a WebAssembly CPU fallback.
              Performance and completion depend on your browser and device.
            </p>
          </div>
        </details>
        <details class="disclosure border-line border p-5">
          <summary class="callout-title"
            >What gets downloaded and cached?</summary
          >
          <div class="post-content mt-3">
            <p>
              Phonon's pinned q8 weights are 64,512,352 bytes (61.5&nbsp;MiB),
              plus roughly 4.2&nbsp;MiB of WebAssembly, its tokenizer, config
              and selected voice. These are file sizes, not a measured total
              browser transfer. Each model loads only when you generate with it.
              Kokoro's WebGPU model is roughly 326&nbsp;MB. The WASM model is
              roughly 92&nbsp;MB, plus its runtime and other assets. A failed
              WebGPU attempt may download both models. Your browser can cache
              these files, but it may evict or revalidate them. Clear this
              site's stored data in your browser settings to remove them.
            </p>
          </div>
        </details>
        <details class="disclosure border-line border p-5">
          <summary class="callout-title">Does my text leave my device?</summary>
          <div class="post-content mt-3">
            <p>
              Speech synthesis runs on your device. The generator does not
              upload the text you enter or the audio it creates. It still loads
              Phonon's runtime from this site, and downloads model files and
              voices from Hugging Face. Kokoro and the MP3 encoder also load
              scripts from jsDelivr. Those providers receive ordinary request
              metadata, including your IP address, browser, requested URL, and
              the time of the request. In production, Fathom records page views
              and the fixed
              <code>Voice generated</code> event. It does not receive your text or
              audio from this generator.
            </p>
          </div>
        </details>
        <details class="disclosure border-line border p-5">
          <summary class="callout-title"
            >Can I use the generated audio commercially?</summary
          >
          <div class="post-content mt-3">
            <p>
              I place no additional restrictions on the audio you generate with
              this tool, whether for personal or commercial projects. You are
              responsible for checking that you have the rights to the source
              text, that its license permits your intended use, and that you
              comply with any other rights that apply. I do not check those
              rights or take responsibility for how you use the audio.
            </p>
          </div>
        </details>
      </div>
    </section>

    <AudioPlayer />
  </Container>
</Layout>

<script>
  import { initVoiceGenerator } from "../../lib/voice-generator-client.mjs";
  document.querySelectorAll(".bh-kokoro-tts-app").forEach(initVoiceGenerator);
</script>
