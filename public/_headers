# Cloudflare Pages response headers.
# See https://developers.cloudflare.com/pages/configuration/headers/
#
# No Cache-Control on /*: Pages joins duplicate header values with a comma, so one
# here would merge into the /_astro/* rule below and defeat it. The Pages default
# for HTML is already max-age=0, must-revalidate.

# Security headers on every response.
#
# script-src needs 'unsafe-inline' (Astro emits inline scripts, and Cloudflare
# injects its own beacon) and 'wasm-unsafe-eval' for the on-device TTS in
# /resources/free-ai-voice-generator/. That page also pulls kokoro-js and lamejs
# from jsDelivr and model weights from Hugging Face, whose LFS CDN answers on
# several hostnames under hf.co and huggingface.co — hence the wildcards.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://cdn.usefathom.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.usefathom.com; font-src 'self'; media-src 'self' blob: data: https://static.buthonestly.io; worker-src 'self' blob:; connect-src 'self' blob: https://cdn.usefathom.com https://cloudflareinsights.com https://app.kit.com https://cdn.jsdelivr.net https://huggingface.co https://*.hf.co https://*.huggingface.co https://static.buthonestly.io https://downloads.buthonestly.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/*.md
  Content-Type: text/markdown; charset=utf-8

# /_astro/ is content-hashed, so a change ships a new URL and these can be
# immutable. HTML stays on the default so deploys show up immediately.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
